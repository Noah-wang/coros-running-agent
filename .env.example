# ── 模型 ───────────────────────────────────────────────────────────────
# 任何 OpenAI 兼容的 Chat Completions 接口都行。
# 只需要换 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL。
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 兼容旧配置名：如果没有设置 LLM_*，程序会读取 DEEPSEEK_*。
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 常见示例：
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1               LLM_MODEL=<chat-completions-model>
# DeepSeek:   LLM_BASE_URL=https://api.deepseek.com                LLM_MODEL=deepseek-chat
# Qwen 国际:  LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Qwen 美国:  LLM_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
# Kimi:       LLM_BASE_URL=https://api.moonshot.ai/v1              LLM_MODEL=kimi-k2.6
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1            LLM_MODEL=openai/gpt-4o

# 嵌入模型。不填则复用上面的 key 和 base_url。
# 换模型之后必须重跑 scripts/ingest_books.py —— 旧向量和新模型不兼容，
# 一致性守卫会发现并退回关键词检索。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

# ── 身份 ───────────────────────────────────────────────────────────────
# 出现在系统提示词里：「你是 X 的个人助理」
AGENT_OWNER_NAME=

# ── COROS 数据源 ───────────────────────────────────────────────────────
# 需要 Node.js 18+：COROS 的 MCP 服务通过 npx mcp-remote 连接。
#
# 这一项通常留空即可，默认是 COROS 官方公共端点 https://mcpus.coros.com/mcp。
# 所有用户共用同一个地址，区别在各自的 OAuth 授权——第一次调用时
# 浏览器会弹出登录页，令牌之后存在 ~/.mcp-auth/ 里。
COROS_MCP_URL=
# 必须固定版本号。写成不带版本的 mcp-remote 会导致请求永远不返回，
# 原因见 README 的常见问题。
COROS_MCP_CLIENT=mcp-remote@0.1.38
COROS_MCP_TIMEOUT_SECONDS=60

# 自动报告：检测到新运动就推送
COROS_AUTO_REPORT_ENABLED=false
COROS_AUTO_REPORT_LOOKBACK_DAYS=3
COROS_AUTO_REPORT_SEND_ON_FIRST_RUN=false

# FIT 归档
COROS_FIT_ARCHIVE_ENABLED=false
COROS_FIT_ARCHIVE_SYNC_LIMIT=45

# ── Discord 入口（可选）────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# 只在这个频道响应。不填则不做频道隔离。
DISCORD_RUNNING_CHANNEL_ID=
DISCORD_ADMIN_CHANNEL_ID=
DISCORD_ADMIN_USER_IDS=

# ── Web 控制台 ─────────────────────────────────────────────────────────
# demo = 离线假数据，可以不配任何 key 看界面
# real = 调用真实能力
WEB_AGENT_MODE=demo
WEB_PUBLIC_DOMAIN=localhost
# 两层限流：按来源挡单 IP 高频，按全局挡分散来源。
# 只按 IP 限流保护不了模型账单，因为账单是按总量算的。
WEB_RATE_LIMIT_PER_MINUTE=10
WEB_RATE_LIMIT_GLOBAL_PER_MINUTE=60

# ── 主 Agent 行为 ──────────────────────────────────────────────────────
# 关掉就退回「分类器挑一个命令」的旧路径。这是个回退开关：
# 循环模式延迟和成本都更高，万一线上表现不好要能一键切回去。
MAIN_AGENT_LOOP_ENABLED=true
ANSWER_REFLECTION_ENABLED=true
NATURAL_LANGUAGE_ROUTING_ENABLED=true
NATURAL_LANGUAGE_ROUTING_CONFIDENCE=0.6
TOOL_TIMEOUT_SECONDS=60

# ── 会话历史 ───────────────────────────────────────────────────────────
CONVERSATION_PERSIST_ENABLED=true
CONVERSATION_COMPRESSION_ENABLED=true
CONVERSATION_IDLE_MINUTES=180

# ── 检索 ───────────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
CHILD_CHUNK_SIZE=700
CHILD_CHUNK_OVERLAP=100
MIN_CHUNK_CHARS=40
# 混合检索（RRF）。实测在跑步语料上比纯向量更差，默认关闭。
RAG_HYBRID_ENABLED=false
RAG_VECTOR_WEIGHT=0.7

# ── 联网搜索（可选）────────────────────────────────────────────────────
# 两个都不填则搜索工具根本不进工具表，模型也就不会承诺做不到的事。
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# 独立于每分钟限流的每日预算：搜索按次收费，而公开入口没有认证。
WEB_SEARCH_DAILY_LIMIT=50

# ── 可观测性 ───────────────────────────────────────────────────────────
# 默认只记提示词指纹，不记明文 —— 里面有成绩、伤病、目标。
# 复现模型异常输出时临时开成 1。
LOG_PROMPTS=0

# ── B 站字幕抓取 ───────────────────────────────────────────────────────
# 登录态放在 agents/coros_report/config.toml，不要写进这里，也不要提交。
# BILIBILI_SUBTITLE_CONFIG=/path/to/config.toml
